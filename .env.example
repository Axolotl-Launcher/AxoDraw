# 复制为 .env.local 并填写真实值（.env.local 已被 git 忽略，不要提交）
# 获取方式：Supabase Dashboard → Project Settings → API

# 项目地址（Project URL），形如 https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# 服务端专用密钥（service_role secret）：
# 只允许在 Node 服务端（API Route / Server Actions）使用，
# 切勿以 NEXT_PUBLIC_ 前缀暴露到浏览器，也不要提交到仓库。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Cloudflare Turnstile 人机验证（创建抽奖接口防脚本刷量）----
# 创建与管理 widget：Cloudflare Dashboard → Turnstile（当前 widget 名为 axodraw-create）

# 服务端验证密钥：只允许在 Node 服务端使用（siteverify），
# 切勿以 NEXT_PUBLIC_ 前缀暴露到浏览器，也不要提交到仓库。
TURNSTILE_SECRET=your-turnstile-secret

# 后端允许的前端 hostname 白名单（逗号分隔，与 widget 注册域名对应）。
# 本地开发填写 localhost,127.0.0.1；
# 生产环境务必只填真实部署域名（如 draw.axlmc.org），不要把 localhost 留在生产白名单。
TURNSTILE_HOSTNAMES=localhost,127.0.0.1

# 公开 sitekey：可安全暴露给浏览器（NEXT_PUBLIC_ 前缀会被 Next.js 内联到客户端）。
NEXT_PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAAAZp...